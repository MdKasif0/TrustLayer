# ─────────────────────────────────────────────────────────────────────────────
# TrustLayer — Digital Media Verification Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Demo Mode Configuration
# Set to 'true' to run TrustLayer with deterministic demo evaluation providers.
# When enabled: upload works, timeline progresses, reports are generated and
# evidence details are displayed without requiring external Python or AI services.
# Set to 'false' to route verification through configured live backends.
NEXT_PUBLIC_DEMO_MODE=true

# ─────────────────────────────────────────────────────────────────────────────
# Server-Side Microservices & AI Model Credentials
# (These remain strictly server-side and are NEVER exposed to client bundles)
# ─────────────────────────────────────────────────────────────────────────────

# Python / FastAPI Backend Service (e.g. PyTorch diffusion artifact detectors)
# PYTHON_BACKEND_URL=http://127.0.0.1:8000

# TrustLayer Enterprise API Gateway
# TRUSTLAYER_API_URL=https://api.trustlayer.internal
# TRUSTLAYER_API_KEY=tl_live_secret_sample_key_here

# C2PA Manifest Parsing Microservice (e.g. c2pa-rs / CAI Rust service)
# C2PA_SERVICE_URL=http://127.0.0.1:8081

# ExifTool / Metadata Extraction Microservice
# METADATA_SERVICE_URL=http://127.0.0.1:8082
